{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ship.schema.json",
  "title": "Карточка корабля (ruleset v3)",
  "description": "Поля по docs/contracts/core-api.md §8. group: 1|2 — обычные группы драфта; 0 — группа «X» исходных правил (Фантом), допустима только при draftable=false. Обязательны все поля, кроме description.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "group",
    "draftable",
    "draft_cost",
    "max_hp",
    "max_shield",
    "initial_charges",
    "max_charges",
    "strength_die",
    "arc_modifiers",
    "abilities",
    "display_name"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Стабильный ASCII snake_case идентификатор типа корабля; совпадает с именем файла."
    },
    "group": {
      "type": "integer",
      "enum": [0, 1, 2],
      "description": "1 или 2 — группа драфта; 0 = группа «X» (вне драфта, только draftable=false)."
    },
    "draftable": {
      "type": "boolean",
      "description": "true — корабль доступен в драфте; false — не выбирается игроками (например, Фантом)."
    },
    "draft_cost": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Стоимость при драфте (бюджет сида — 17)."
    },
    "max_hp": { "type": "integer", "minimum": 1 },
    "max_shield": { "type": "integer", "minimum": 0 },
    "initial_charges": { "const": 3 },
    "max_charges": { "const": 5 },
    "strength_die": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sides"],
      "properties": {
        "count": { "const": 1 },
        "sides": { "const": 6 }
      }
    },
    "arc_modifiers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "integer", "minimum": -10, "maximum": 10 },
      "description": "Ровно 6 целых модификаторов по секторам в порядке F, FR, BR, B, BL, FL (индекс = sector_index)."
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "enabled": {
            "type": "boolean",
            "description": "false — способность отключена до M2 (ADR-011); движок спринта 1 её игнорирует."
          }
        }
      }
    },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" }
  }
}
